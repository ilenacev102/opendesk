# Копирај во .env и пополни пред docker compose up
SERVICEDESK_SECRET=смени-ме-со-долг-случаен-клуч
# Опционално:
# SERVICEDESK_BIND=127.0.0.1
# SERVICEDESK_PORT=5000
# Прв администратор (се креира при старт ако нема корисници):
# SERVICEDESK_ADMIN_USER=admin
# SERVICEDESK_ADMIN_PASS=смени-ме-со-долга-лозинка
# SMTP нотификации (без нив mail-пораките тивко се прескокнуваат):
# SERVICEDESK_SMTP_HOST=mail.example.mk
# SERVICEDESK_SMTP_PORT=587
# SERVICEDESK_SMTP_USER=srv
# SERVICEDESK_SMTP_PASS=sekret
# SERVICEDESK_SMTP_FROM=servicedesk@example.mk
# SERVICEDESK_ADMIN_EMAIL=admin@example.mk
# Приватни брендирани шаблони (инаку се користат неутралните од templates/):
# SERVICEDESK_TEMPLATES_DIR=/path/to/branded-templates
