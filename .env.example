# Копирај во .env и пополни пред docker compose up
SERVICEDESK_SECRET=смени-ме-со-долг-случаен-клуч
# Опционално:
# SERVICEDESK_BIND=127.0.0.1
# SERVICEDESK_PORT=5000
# Прв администратор (се креира при старт ако нема корисници):
# SERVICEDESK_ADMIN_USER=admin
# SERVICEDESK_ADMIN_PASS=смени-ме-со-долга-лозинка
# SMTP нотификации (без нив mail-пораките тивко се прескокнуваат):
# SERVICEDESK_SMTP_HOST=mail.example.mk
# SERVICEDESK_SMTP_PORT=587
# SERVICEDESK_SMTP_USER=srv
# SERVICEDESK_SMTP_PASS=sekret
# SERVICEDESK_SMTP_FROM=servicedesk@example.mk
# SERVICEDESK_ADMIN_EMAIL=admin@example.mk
# Приватни брендирани шаблони (инаку се користат неутралните од templates/):
# SERVICEDESK_TEMPLATES_DIR=/path/to/branded-templates
# Postgres наместо SQLite (инаку SQLite default; потребен pg профил):
# SERVICEDESK_DB_URL=postgresql://servicedesk:ТАЈНА@db:5432/servicedesk
# SERVICEDESK_PG_PASSWORD=ТАЈНА
# LDAP/AD read-only sync (инаку само локални корисници):
# SERVICEDESK_LDAP_URL=ldap://ad.firma.mk:389
# SERVICEDESK_LDAP_BIND_DN=CN=svc,OU=Service,DC=firma,DC=mk
# SERVICEDESK_LDAP_PASSWORD=ТАЈНА
# SERVICEDESK_LDAP_BASE=OU=Users,DC=firma,DC=mk
# SERVICEDESK_LDAP_FILTER=(objectClass=user)
# Rate-limit backend (memory default; file се дели меѓу workers):
# SERVICEDESK_RATELIMIT=memory
# SERVICEDESK_RATELIMIT_FILE=/app/data/ratelimit.json
# Email-to-ticket intake (инаку без mail; само рачен trigger, без daemon):
# SERVICEDESK_IMAP_HOST=mail.firma.mk
# SERVICEDESK_IMAP_PORT=993
# SERVICEDESK_IMAP_USER=tiket@firma.mk
# SERVICEDESK_IMAP_PASSWORD=ТАЈНА
# SERVICEDESK_IMAP_MAILBOX=INBOX
# SERVICEDESK_IMAP_SSL=1
# SSO најава преку OIDC (Entra ID / Google / Keycloak; инаку само локална):
# SERVICEDESK_OIDC_ISSUER=https://login.microsoftonline.com/ТЕНАНТ/v2.0
# SERVICEDESK_OIDC_CLIENT_ID=ПРИЈАВА-ID
# SERVICEDESK_OIDC_CLIENT_SECRET=ТАЈНА
# SERVICEDESK_OIDC_NAME=Microsoft
# SERVICEDESK_OIDC_DEFAULT_ROLE=citac
